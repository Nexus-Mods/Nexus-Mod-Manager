{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nexus-Mods/Nexus-Mod-Manager/schemas/game-mode.schema.json",
  "title": "Nexus Mod Manager CE Game Mode Definition",
  "description": "Authoritative schema for GameModes/Definitions/<ModeId>/game.json. Supported external tools are declared only in the optional supportedTools.json companion file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modeId",
    "name",
    "behaviorProfile",
    "gameExecutables"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor-only schema hint. NMM does not use this value as runtime configuration."
    },
    "schemaVersion": {
      "type": "integer",
      "const": 2,
      "description": "Game-mode definition contract version. Version 2 removes inert/duplicated fields and separates supported tools into their own document."
    },
    "modeId": {
      "$ref": "#/$defs/identifier",
      "description": "Stable, globally unique game-mode identifier. Do not change after release."
    },
    "nexusDomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Optional canonical Nexus catalog slug. Does not change ModeId, storage or ownership. Installed modes sharing an explicitly declared catalog participate in inbound NXM destination selection. Omission preserves legacy aliases."
    },
    "name": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Display name shown by NMM."
    },
    "behaviorProfile": {
      "type": "string",
      "enum": [
        "generic",
        "gamebryo",
        "baldursgate3",
        "witcher3remastered",
        "managed-content"
      ],
      "description": "Selects the runtime behavior base. Plugin management is currently part of the gamebryo profile; baldursgate3 preserves BG3-specific split-root and manifest behavior."
    },
    "legacyFallback": {
      "type": "boolean",
      "default": false,
      "description": "When true, an already registered legacy DLL game mode with the same id takes precedence."
    },
    "gameExecutables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/executableRelativePath"
      },
      "uniqueItems": true,
      "description": "Executable names or game-relative executable paths used for install validation and version detection."
    },
    "stopFolders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relativePath"
      },
      "uniqueItems": true,
      "description": "Archive folder markers used to locate the effective mod root."
    },
    "supportedFormats": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
      },
      "uniqueItems": true,
      "description": "Supported mod format identifiers. When omitted, the runtime may use its normal fallback."
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    },
    "pluginExtensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileExtension"
      },
      "uniqueItems": true,
      "description": "Physical plugin extensions recognized by a plugin-capable Gamebryo mode."
    },
    "orderedCriticalPluginNames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileName"
      },
      "uniqueItems": true,
      "description": "Critical plugins in fixed leading order."
    },
    "orderedOfficialPluginNames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileName"
      },
      "uniqueItems": true,
      "description": "Official managed plugins in their fixed relative order."
    },
    "orderedOfficialUnmanagedPluginNames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileName"
      },
      "uniqueItems": true,
      "description": "Official plugins treated as unmanaged."
    },
    "plugin": {
      "$ref": "#/$defs/plugin"
    },
    "launcher": {
      "$ref": "#/$defs/launcher"
    },
    "resources": {
      "$ref": "#/$defs/resources"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "setup": {
      "$ref": "#/$defs/setup"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "modInstall": {
      "$ref": "#/$defs/modInstall"
    },
    "packageFiles": {
      "$ref": "#/$defs/packageFiles"
    },
    "structuredEffects": {
      "$ref": "#/$defs/structuredEffects"
    },
    "managedContent": {
      "$ref": "#/$defs/managedContent"
    },
    "gamebryo": {
      "$ref": "#/$defs/gamebryo"
    },
    "requiredToolName": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Legacy mandatory-tool display label. This is separate from optional supportedTools.json entries."
    },
    "orderedRequiredToolFileNames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relativePath"
      },
      "uniqueItems": true,
      "description": "Legacy files used to verify that a mandatory external tool is installed."
    },
    "requiredToolErrorMessage": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Message displayed when the mandatory external tool is missing."
    },
    "criticalFilesErrorMessage": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Message displayed when required base-game files are missing."
    },
    "compatibilityNotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true,
      "description": "Maintainer-facing notes for intentionally preserved legacy behavior."
    }
  },
  "dependentRequired": {
    "requiredToolName": [
      "orderedRequiredToolFileNames",
      "requiredToolErrorMessage"
    ],
    "orderedRequiredToolFileNames": [
      "requiredToolName",
      "requiredToolErrorMessage"
    ],
    "requiredToolErrorMessage": [
      "requiredToolName",
      "orderedRequiredToolFileNames"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "behaviorProfile": {
            "const": "managed-content"
          }
        },
        "required": [
          "behaviorProfile"
        ]
      },
      "then": {
        "required": [
          "managedContent"
        ]
      }
    },
    {
      "if": {
        "required": [
          "managedContent"
        ]
      },
      "then": {
        "required": [
          "modInstall"
        ],
        "properties": {
          "behaviorProfile": {
            "enum": [
              "managed-content",
              "witcher3remastered"
            ]
          },
          "modInstall": {
            "properties": {
              "pathAdjustmentProfile": {
                "const": "none"
              },
              "supportsGameRootInstall": {
                "const": false
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "managedInstallationPath"
                  ]
                },
                {
                  "properties": {
                    "gameRootPackageRules": {
                      "minItems": 1
                    }
                  },
                  "required": [
                    "gameRootPackageRules"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "modeId": {
            "const": "Witcher3Remastered"
          }
        },
        "required": [
          "modeId"
        ]
      },
      "then": {
        "properties": {
          "behaviorProfile": {
            "const": "witcher3remastered"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "behaviorProfile": {
            "const": "gamebryo"
          }
        },
        "required": [
          "behaviorProfile"
        ]
      },
      "then": {
        "required": [
          "plugin",
          "pluginExtensions"
        ],
        "properties": {
          "plugin": {
            "properties": {
              "usesPlugins": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "plugin"
              ]
            },
            {
              "required": [
                "pluginExtensions"
              ]
            },
            {
              "required": [
                "orderedCriticalPluginNames"
              ]
            },
            {
              "required": [
                "orderedOfficialPluginNames"
              ]
            },
            {
              "required": [
                "orderedOfficialUnmanagedPluginNames"
              ]
            },
            {
              "required": [
                "gamebryo"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "structuredEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "provider",
        "revision",
        "metadataFile",
        "metadataArray",
        "metadataEncoding",
        "profileRoot",
        "manifestFile",
        "excludedProfiles",
        "keyPrefix",
        "containerId",
        "recordId",
        "identityField",
        "fields"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "provider": {
          "const": "profiled-attribute-records-v1",
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "metadataFile": {
          "$ref": "#/$defs/fileName"
        },
        "metadataArray": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "metadataEncoding": {
          "enum": [
            "Ascii",
            "Utf8"
          ],
          "type": "string"
        },
        "profileRoot": {
          "$ref": "#/$defs/relativePath"
        },
        "manifestFile": {
          "$ref": "#/$defs/fileName"
        },
        "excludedProfiles": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fileName"
          }
        },
        "keyPrefix": {
          "type": "string",
          "maxLength": 129,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*\\|$"
        },
        "containerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "identityField": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/structuredRecordField"
          }
        }
      },
      "description": "Native-owned GUID attribute records in existing LocalAppData profile XML. Literal node/attribute structure, metadata aliases and stable key namespace; no XPath or script execution."
    },
    "structuredRecordField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          }
        },
        "value": {
          "type": "string",
          "maxLength": 4096
        },
        "defaultValue": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "oneOf": [
        {
          "required": [
            "sources"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        },
        {
          "required": [
            "value"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sources"
                ]
              },
              {
                "required": [
                  "defaultValue"
                ]
              }
            ]
          }
        }
      ]
    },

    "managedContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "installLayout"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "installLayout": {
          "$ref": "#/$defs/managedContentInstallLayout"
        },
        "componentOrdering": {
          "$ref": "#/$defs/managedContentComponentOrdering"
        }
      }
    },
    "managedContentComponentOrdering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "revision",
        "fileRoot",
        "relativePath",
        "componentKind",
        "componentPrefix",
        "priorityKey",
        "enabledKey"
      ],
      "properties": {
        "provider": {
          "const": "sectioned-ini-order-v1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "fileRoot": {
          "enum": [
            "GameRoot",
            "Documents"
          ]
        },
        "relativePath": {
          "allOf": [
            {
              "$ref": "#/$defs/relativePath"
            }
          ],
          "maxLength": 4096,
          "description": "Literal Windows-safe relative path; no absolute paths, traversal, templates or executable substitutions."
        },
        "componentKind": {
          "$ref": "#/$defs/identifier"
        },
        "componentPrefix": {
          "$ref": "#/$defs/fileName",
          "maxLength": 255
        },
        "priorityKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "enabledKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "editing": {
          "type": "string",
          "const": "reviewed-sequential-ini-v1",
          "description": "Opt-in existing-file editing: complete configured order, sequential priorities 1-9999, 0/1 enabled, explicit review and recovery. Not supported by the reserved Remastered adapter."
        }
      },
      "description": "Read-only INI order-file observation. Component kind must resolve to one configured target folder/prefix. This provider does not publish settings or enable order writes."
    },
    "managedContentInstallLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "revision",
        "rules"
      ],
      "properties": {
        "provider": {
          "const": "bounded-folder-layout-v1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "maximumWrapperSegments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 0
        },
        "ignoredFileNames": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001F]+$",
            "description": "Literal single Windows-safe segment; runtime also rejects device names, dot/trailing-dot/space aliases."
          }
        },
        "rejectedFileSuffixes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001F]+$",
            "description": "Literal single Windows-safe segment; runtime also rejects device names, dot/trailing-dot/space aliases."
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/managedContentLayoutRule"
          }
        }
      }
    },
    "managedContentLayoutRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "componentPrefix",
        "contentFolder",
        "targetRoot",
        "targetFolder",
        "componentKind",
        "maximumComponentNameLength"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "component-folder",
            "generated-folder"
          ]
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001F]+$",
          "description": "Literal single Windows-safe segment; runtime also rejects device names, dot/trailing-dot/space aliases."
        },
        "componentPrefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001F]+$",
          "description": "Literal single Windows-safe segment; runtime also rejects device names, dot/trailing-dot/space aliases."
        },
        "contentFolder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001F]+$",
          "description": "Literal single Windows-safe segment; runtime also rejects device names, dot/trailing-dot/space aliases."
        },
        "targetRoot": {
          "const": "Data"
        },
        "targetFolder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001F]+$",
          "description": "Literal single Windows-safe segment; runtime also rejects device names, dot/trailing-dot/space aliases."
        },
        "componentKind": {
          "$ref": "#/$defs/identifier"
        },
        "maximumComponentNameLength": {
          "type": "integer",
          "minimum": 13,
          "maximum": 255
        }
      },
      "description": "Component folders: [sourceRoot/]componentPrefix*/contentFolder/<file>. Generated folders: sourceRoot/<file> maps to targetFolder/<stable-name>/contentFolder/<file>; sourceRoot must equal contentFolder. Runtime validates duplicate IDs, case aliases and name-budget relationships.",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "generated-folder"
              }
            }
          },
          "then": {
            "required": [
              "sourceRoot"
            ]
          }
        }
      ]
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}$)(?!.*[ .]$)[^\\\\/:*?\\\"<>|\\u0000-\\u001F]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^[\\\\/]"
          }
        },
        {
          "not": {
            "pattern": "^[A-Za-z]:"
          }
        },
        {
          "not": {
            "pattern": "(^|[\\\\/])\\.\\.($|[\\\\/])"
          }
        },
        {
          "not": {
            "pattern": "[<>:\\\"|?*\\u0000-\\u001F]"
          }
        }
      ]
    },
    "relativePathOrEmpty": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/relativePath"
        }
      ]
    },
    "pathTemplate": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "pattern": "(^|[\\\\/])\\.\\.($|[\\\\/])"
      }
    },
    "fileExtension": {
      "type": "string",
      "pattern": "^\\.[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "executableRelativePath": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "pattern": "\\.[eE][xX][eE]$"
        }
      ]
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "steamAppId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Legacy Steam app-id shortcut."
        },
        "steamInstallFolderName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "steamExecutableName": {
          "$ref": "#/$defs/executableRelativePath",
          "description": "Game-relative executable path used to validate a detected Steam installation."
        },
        "gogRegistryKey": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Legacy GOG registry shortcut."
        },
        "gogPathValueName": {
          "type": "string"
        },
        "stores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/storeDiscovery"
          },
          "description": "Ordered discovery candidates. Prefer this form over the legacy shortcuts."
        }
      },
      "anyOf": [
        {
          "required": [
            "steamAppId"
          ]
        },
        {
          "required": [
            "gogRegistryKey"
          ]
        },
        {
          "required": [
            "stores"
          ]
        }
      ],
      "dependentRequired": {
        "steamInstallFolderName": [
          "steamAppId"
        ],
        "steamExecutableName": [
          "steamAppId"
        ],
        "gogPathValueName": [
          "gogRegistryKey"
        ]
      }
    },
    "storeDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store"
      ],
      "properties": {
        "store": {
          "type": "string",
          "enum": [
            "Steam",
            "GOG",
            "Epic",
            "MicrosoftStore",
            "Xbox",
            "Custom"
          ]
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "installFolderName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "executableName": {
          "$ref": "#/$defs/executableRelativePath",
          "description": "Game-relative executable path used to validate the detected store installation."
        },
        "registryKey": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "registryValueName": {
          "type": "string"
        },
        "pathSuffix": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "anyOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "installFolderName"
          ]
        },
        {
          "required": [
            "executableName"
          ]
        },
        {
          "required": [
            "registryKey"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "store": {
                "enum": [
                  "Steam",
                  "Epic",
                  "MicrosoftStore",
                  "Xbox"
                ]
              }
            },
            "required": [
              "store"
            ]
          },
          "then": {
            "required": [
              "id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "store": {
                "const": "GOG"
              }
            },
            "required": [
              "store"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "id"
                ]
              },
              {
                "required": [
                  "registryKey"
                ]
              }
            ]
          }
        }
      ]
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usesPlugins",
        "pluginDirectorySuffix",
        "supportsPluginAutoSorting",
        "maxAllowedActivePluginsCount"
      ],
      "properties": {
        "usesPlugins": {
          "type": "boolean",
          "const": true,
          "description": "Explicitly true for the current Gamebryo plugin-management profile."
        },
        "pluginDirectorySuffix": {
          "$ref": "#/$defs/relativePathOrEmpty",
          "description": "Plugin directory relative to the managed installation path, for example Data."
        },
        "supportsPluginAutoSorting": {
          "type": "boolean"
        },
        "maxAllowedActivePluginsCount": {
          "type": "integer",
          "minimum": 0,
          "description": "0 means no additional global limit; address-space limits may still apply."
        },
        "officialUnmanagedPluginListFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathTemplate"
          },
          "uniqueItems": true,
          "description": "Text files containing additional official unmanaged plugin names. Path placeholders are allowed."
        },
        "policy": {
          "$ref": "#/$defs/pluginPolicy"
        }
      }
    },
    "pluginPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "parserStrategy": {
          "$ref": "#/$defs/strategyName"
        },
        "persistenceStrategy": {
          "$ref": "#/$defs/strategyName"
        },
        "masterPluginsMustLoadBeforeNonMasters": {
          "type": "boolean"
        },
        "validateDependencies": {
          "type": "boolean"
        },
        "pluginsFilePath": {
          "$ref": "#/$defs/pathTemplate"
        },
        "loadOrderFilePath": {
          "$ref": "#/$defs/pathTemplate"
        },
        "encodingName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "activeMarker": {
          "type": "string"
        },
        "inactiveMarker": {
          "type": "string"
        },
        "appDataGameFolderName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "useTimestampOrder": {
          "type": "boolean"
        },
        "ignoreOfficialPlugins": {
          "type": "boolean"
        },
        "forcedReadOnly": {
          "type": "boolean"
        },
        "singleFileManagement": {
          "type": "boolean"
        },
        "officialPluginsAreImplicitlyActive": {
          "type": "boolean"
        },
        "loadOrderInPluginDirectory": {
          "type": "boolean"
        },
        "showStarfieldCustomPluginsHeader": {
          "type": "boolean"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pluginExtensionPolicy"
          },
          "uniqueItems": true
        },
        "headerFlagMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pluginHeaderFlagMapping"
          },
          "uniqueItems": true
        },
        "addressSpaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pluginAddressSpace"
          },
          "uniqueItems": true
        },
        "officialPlugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileName"
          },
          "uniqueItems": true
        },
        "criticalPlugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileName"
          },
          "uniqueItems": true
        },
        "fixedOrderPlugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileName"
          },
          "uniqueItems": true
        },
        "forcedActivePlugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileName"
          },
          "uniqueItems": true
        },
        "blueprintPlugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileName"
          },
          "uniqueItems": true
        },
        "blueprintPluginPrefixes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      }
    },
    "strategyName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
      "description": "Registered strategy identifier. The runtime validator must reject unknown strategies."
    },
    "enumFlags": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\s*\\|\\s*[A-Za-z][A-Za-z0-9]*)*$",
      "description": "One or more runtime enum names separated by |."
    },
    "pluginExtensionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension"
      ],
      "properties": {
        "extension": {
          "$ref": "#/$defs/fileExtension"
        },
        "forcedFlags": {
          "$ref": "#/$defs/enumFlags"
        },
        "forcedAddressClass": {
          "type": "string",
          "enum": [
            "None",
            "Full",
            "Light",
            "Medium",
            "Small"
          ]
        }
      }
    },
    "pluginHeaderFlagMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mask",
        "flags"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "RecordFlags1",
            "RecordFlags2",
            "RecordFlags3"
          ]
        },
        "mask": {
          "$ref": "#/$defs/uint32Value"
        },
        "flags": {
          "$ref": "#/$defs/enumFlags"
        }
      }
    },
    "pluginAddressSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addressClass",
        "firstIndex",
        "maxCount"
      ],
      "properties": {
        "addressClass": {
          "type": "string",
          "enum": [
            "Full",
            "Light",
            "Medium",
            "Small"
          ]
        },
        "firstIndex": {
          "type": "integer",
          "minimum": 0
        },
        "maxCount": {
          "type": "integer",
          "minimum": 0,
          "description": "0 means unlimited."
        },
        "displayFormat": {
          "$ref": "#/$defs/nonEmptyString",
          "description": ".NET numeric composite format used to display the allocated index."
        }
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultExecutable",
        "allowCustomCommand"
      ],
      "properties": {
        "defaultExecutable": {
          "$ref": "#/$defs/executableRelativePath"
        },
        "prelauncherExecutable": {
          "$ref": "#/$defs/executableRelativePath",
          "description": "Optional launch-only executable, preferred when installed. Does not participate in game discovery/version detection; absence falls back to defaultExecutable and gameExecutables."
        },
        "plainCommandName": {
          "$ref": "#/$defs/identifier"
        },
        "plainCommandText": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "customCommandName": {
          "$ref": "#/$defs/identifier"
        },
        "customCommandText": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "defaultCommandText": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "allowCustomCommand": {
          "type": "boolean",
          "description": "Single source of truth for both custom-launch availability and its settings UI."
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "iconPath": {
          "$ref": "#/$defs/fileName"
        },
        "categoriesPath": {
          "$ref": "#/$defs/fileName"
        },
        "baseFilesPath": {
          "$ref": "#/$defs/fileName"
        }
      },
      "description": "Resource file names relative to the definition directory. Subdirectories are not allowed."
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryColor"
      ],
      "properties": {
        "primaryColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "useGenericSetup"
      ],
      "properties": {
        "useGenericSetup": {
          "type": "boolean"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "useGenericSettings"
      ],
      "properties": {
        "useGenericSettings": {
          "type": "boolean"
        }
      },
      "description": "Custom-launch settings visibility follows launcher.allowCustomCommand; there is no duplicate flag here."
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shareModsStorageWith"
      ],
      "properties": {
        "shareModsStorageWith": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true,
          "description": "Exact modeId values with which this Game Mode may share only its Mods archive/cache folder. Sharing is enabled only when both definitions list each other."
        }
      }
    },
    "modInstall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pathAdjustmentProfile",
        "supportsGameRootInstall"
      ],
      "properties": {
        "pathAdjustmentProfile": {
          "type": "string",
          "enum": [
            "none",
            "cyberpunk2077",
            "fallout4",
            "oblivionremastered",
            "starfield",
            "stardewvalley",
            "subnautica",
            "sims4",
            "nomanssky"
          ],
          "description": "Only profiles with an implementation in the supplied source are part of schema v2."
        },
        "managedInstallationPath": {
          "$ref": "#/$defs/pathTemplate",
          "description": "Overrides the directory managed by the mod installer."
        },
        "hardlinkRequiredExtensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileExtension"
          },
          "uniqueItems": true,
          "description": "Complete authoritative hardlink-required extension list for this Game Mode. Omit the property to inherit the runtime default."
        },
        "realFileRequiredExtensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileExtension"
          },
          "uniqueItems": true
        },
        "supportsGameRootInstall": {
          "type": "boolean"
        },
        "gameRootPackageRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gameRootPackageRule"
          },
          "description": "Optional exact package signatures. Omit or use an empty list to preserve normal installation behavior. Runtime validation also rejects duplicate rule ids and case-insensitive file-name duplicates."
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["gameRootPackageRules"],
            "properties": {
              "gameRootPackageRules": { "minItems": 1 }
            }
          },
          "then": {
            "properties": {
              "supportsGameRootInstall": { "const": true }
            }
          }
        }
      ]
    },
    "gameRootPackageRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requiredFiles"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "not": { "pattern": "[\\u0000-\\u001F]" }
        },
        "requiredFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fileName" },
          "description": "Exact file names that must all occur directly at the same archive base. Paths and wildcards are not supported."
        },
        "xmlChecks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/gameRootPackageXmlCheck" }
        },
        "allowSingleWrapperFolder": {
          "type": "boolean",
          "default": false,
          "description": "Allows one common enclosing folder, excluding Data and GameMode stopFolders. All archive files must be inside that folder."
        }
      }
    },
    "gameRootPackageXmlCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "elementPath"],
      "properties": {
        "file": {
          "$ref": "#/$defs/fileName",
          "description": "Must name a file in the rule's requiredFiles list."
        },
        "elementPath": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9._-]*$",
            "not": { "pattern": "[\\u0000-\\u001F]" }
          },
          "description": "Case-sensitive, unqualified element names from the document root through direct children. This is not XPath."
        }
      }
    },
    "gamebryo": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "scriptExtenderExecutables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executableRelativePath"
          },
          "uniqueItems": true
        },
        "scriptExtenderAutoLoadFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "uniqueItems": true,
          "description": "Game-relative marker files whose presence means the script extender auto-loads when the normal game executable is started."
        },
        "requiresOptionalFilesCheckOnProfileSwitch": {
          "type": "boolean",
          "description": "Preserves additional plugin-directory files selected by the profile manager during profile switches."
        },
        "optionalFileNamePrefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true,
          "description": "Case-insensitive filename prefixes used to select generated plugin-directory files for profile preservation."
        },
        "postProfileSwitchToolPath": {
          "$ref": "#/$defs/pathTemplate",
          "description": "Optional executable path offered after a profile switch."
        },
        "postProfileSwitchToolMessage": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Prompt shown before launching the configured post-profile-switch tool."
        },
        "userGameDataPath": {
          "$ref": "#/$defs/pathTemplate"
        },
        "iniFilePath": {
          "$ref": "#/$defs/pathTemplate"
        },
        "rendererFilePath": {
          "$ref": "#/$defs/pathTemplate"
        },
        "pluginsFilePath": {
          "$ref": "#/$defs/pathTemplate"
        },
        "archiveInvalidationProfile": {
          "type": "string",
          "enum": [
            "none",
            "fallout3",
            "falloutnv",
            "oblivion"
          ],
          "default": "none",
          "description": "Selects a built-in Archive Invalidation implementation. When omitted, Archive Invalidation is disabled."
        },
        "additionalSettingsFiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/pathTemplate"
          }
        }
      },
      "dependentRequired": {
        "postProfileSwitchToolPath": [
          "postProfileSwitchToolMessage"
        ],
        "postProfileSwitchToolMessage": [
          "postProfileSwitchToolPath"
        ]
      }
    },
    "uint32Value": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        {
          "type": "string",
          "pattern": "^0[xX](?=[0-9A-Fa-f]{1,8}$)(?!0+$)[0-9A-Fa-f]+$"
        }
      ],
      "description": "Non-zero UInt32 written as a JSON integer or a 0x-prefixed hexadecimal string."
    },
    "packageFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "provider",
        "revision",
        "sourceFolder",
        "destinationPath",
        "documentRoot",
        "recordElement",
        "identityAttribute"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "provider": {
          "type": "string",
          "const": "package-xml-elements-v1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sourceFolder": {
          "$ref": "#/$defs/relativePath"
        },
        "destinationPath": {
          "$ref": "#/$defs/relativePath"
        },
        "documentRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "recordElement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "identityAttribute": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "description": "Optional package-local XML record merge. Inputs are consumed from this archive only; the output is an ordinary native-owned Data file. Runtime validation enforces unqualified XML names, independent paths, supported hosts and configured managed-layout bounds. No cross-mod union/rebuild is implied."
    }
  }
}
