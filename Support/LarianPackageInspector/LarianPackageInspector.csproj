<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\Stage\obj\LarianPackageInspector\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="Dependencies.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeFrameworkVersion Condition="'$(SelfContained)' == 'true'">$(LarianRuntimeFrameworkVersion)</RuntimeFrameworkVersion>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LSLibDirectory Condition="'$(LSLibDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\Stage\Dependencies\LSLib-$(LarianDependencyVersion)\dist\Packed</LSLibDirectory>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\Stage\Helpers\LarianPackageInspector\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="@(LarianDependencyAssembly)">
      <HintPath>$(LSLibDirectory)\%(Identity).dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="$(LSLibDirectory)\LSLibNative.dll" Link="LSLibNative.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequirePinnedLSLib" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(LSLibDirectory)\LSLib.dll')" Text="Run Support/LarianPackageInspector/Build.ps1 to acquire the checksum-pinned LSLib dependency." />
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
