{
  "schemaVersion": 2,
  "modeId": "Fallout4",
  "name": "Fallout 4",
  "runtime": {
    "schemaVersion": 1,
    "startupNotice": {
      "preference": "ShowFallout4UpgradeDisclaimer",
      "minimumVersion": "1.5.0.0",
      "includeMinimumVersion": false,
      "requiresObsoletePluginConfiguration": true,
      "text": "We've detected that you are using Fallout 4 version 1.5 (or later) for the first time with NMM. In version 1.5, \nBethesda changed the way in which plugins were handled.\n\nBecause of this, any plugin you previously had enabled will be disabled in NMM and you will need to reactivate \nthem in order for your setup to work again.\n\nUnfortunately this is a side-effect of Bethesda's patching of Fallout 4 and nothing to do with us. Unless \nBethesda change the modding method again in future patches you will only need to do this reactivation once \n(e.g. this won't happen every time you start NMM in the future!).\n\nNOTE: If you are making use of NMM's profile system, simply go to the profile menu and select 'Import Load Order' \nfrom your profile, NMM will automatically reactivate all your plugins in the correct order for you.\n\nIf you are not using the profiling system, you will need to activate all your plugins again manually."
    }
  },
  "behaviorProfile": "gamebryo",
  "legacyFallback": false,
  "gameExecutables": [
    "Fallout4.exe",
    "Fallout4Launcher.exe"
  ],
  "stopFolders": [
    "textures",
    "scripts",
    "meshes",
    "music",
    "shaders",
    "shadersfx",
    "video",
    "interface",
    "facegen",
    "menus",
    "lodsettings",
    "lsdata",
    "sound",
    "materials",
    "strings",
    "tools",
    "F4SE"
  ],
  "pluginExtensions": [
    ".esm",
    ".esl",
    ".esp"
  ],
  "orderedCriticalPluginNames": [
    "Fallout4.esm"
  ],
  "orderedOfficialPluginNames": [
    "DLCRobot.esm",
    "DLCworkshop01.esm",
    "DLCCoast.esm",
    "DLCworkshop02.esm",
    "DLCworkshop03.esm",
    "DLCNukaWorld.esm"
  ],
  "orderedOfficialUnmanagedPluginNames": [
    "DLCRobot.esm",
    "DLCworkshop01.esm",
    "DLCCoast.esm",
    "DLCworkshop02.esm",
    "DLCworkshop03.esm",
    "DLCNukaWorld.esm"
  ],
  "supportedFormats": [
    "fomod"
  ],
  "discovery": {
    "stores": [
      {
        "store": "Steam",
        "id": "377160",
        "installFolderName": "Fallout 4",
        "executableName": "Fallout4.exe"
      },
      {
        "store": "GOG",
        "id": "1998527297",
        "executableName": "Fallout4.exe"
      }
    ]
  },
  "plugin": {
    "usesPlugins": true,
    "pluginDirectorySuffix": "Data",
    "supportsPluginAutoSorting": false,
    "maxAllowedActivePluginsCount": 255,
    "officialUnmanagedPluginListFiles": [
      "{GamePath}\\Fallout4.ccc"
    ],
    "policy": {
      "schemaVersion": 1,
      "persistenceStrategy": "singleFile",
      "pluginsFilePath": "{LocalApplicationData}\\Fallout4\\plugins.txt",
      "loadOrderFilePath": "{LocalApplicationData}\\Fallout4\\plugins.txt",
      "activeMarker": "*",
      "appDataGameFolderName": "Fallout4",
      "useTimestampOrder": false,
      "ignoreOfficialPlugins": true,
      "forcedReadOnly": false,
      "singleFileManagement": true,
      "officialPluginsAreImplicitlyActive": true
    }
  },
  "launcher": {
    "defaultExecutable": "Fallout4Launcher.exe",
    "plainCommandName": "PlainLaunch",
    "plainCommandText": "Launch Fallout 4",
    "customCommandName": "CustomLaunch",
    "customCommandText": "Launch Custom Fallout 4",
    "defaultCommandText": "Launch Fallout 4",
    "allowCustomCommand": true
  },
  "resources": {
    "iconPath": "Fallout4_logo.ico",
    "categoriesPath": "Categories.xml",
    "baseFilesPath": "fallout4_base.txt"
  },
  "theme": {
    "primaryColor": "#32689E"
  },
  "setup": {
    "useGenericSetup": true
  },
  "settings": {
    "useGenericSettings": true
  },
  "modInstall": {
    "pathAdjustmentProfile": "fallout4",
    "hardlinkRequiredExtensions": [
      ".esp",
      ".esl",
      ".esm",
      ".ba2",
      ".bsa",
      ".mp3",
      ".bgsm",
      ".bgem",
      ".wav",
      ".ogg",
      ".xwm"
    ],
    "supportsGameRootInstall": true,
    "gameRootPackageRules": [
      {
        "id": "xse-plugin-preloader",
        "requiredFiles": [
          "WinHTTP.dll",
          "xSE PluginPreloader.xml"
        ],
        "xmlChecks": [
          {
            "file": "xSE PluginPreloader.xml",
            "elementPath": [
              "xSE",
              "PluginPreloader"
            ]
          }
        ],
        "allowSingleWrapperFolder": true
      }
    ]
  },
  "gamebryo": {
    "scriptExtenderExecutables": [
      "f4se_loader.exe"
    ],
    "userGameDataPath": "{PersonalData}\\My Games\\Fallout4",
    "iniFilePath": "{UserGameData}\\Fallout4Custom.ini",
    "pluginsFilePath": "{LocalApplicationData}\\Fallout4\\plugins.txt",
    "additionalSettingsFiles": {
      "FOPrefsIniPath": "{UserGameData}\\Fallout4Prefs.ini"
    }
  }
}
