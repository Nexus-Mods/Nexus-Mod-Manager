{
  "schemaVersion": 2,
  "modeId": "BaldursGate3",
  "name": "Baldur's Gate 3",
  "runtime": {
    "schemaVersion": 1,
    "collectionAdapter": "module-settings-v1",
    "collectionDomain": "baldursgate3",
    "collectionMemberTypes": [
      "bg3-loose",
      "bg3-replacer",
      "bg3-bg3se",
      "dinput"
    ],
    "collectionOrderProvidesMetadata": true
  },
  "behaviorProfile": "baldursgate3",
  "legacyFallback": false,
  "gameExecutables": [
    "Launcher\\LariLauncher.exe"
  ],
  "stopFolders": [
    "bin",
    "Data"
  ],
  "supportedFormats": [
    "fomod"
  ],
  "discovery": {
    "stores": [
      {
        "store": "Steam",
        "id": "1086940",
        "installFolderName": "Baldurs Gate 3",
        "executableName": "Launcher\\LariLauncher.exe"
      }
    ]
  },
  "launcher": {
    "defaultExecutable": "Launcher\\LariLauncher.exe",
    "plainCommandName": "PlainLaunch",
    "plainCommandText": "Launch Baldur's Gate 3",
    "customCommandName": "CustomLaunch",
    "customCommandText": "Launch Custom Baldur's Gate 3",
    "defaultCommandText": "Launch Baldur's Gate 3",
    "allowCustomCommand": true
  },
  "resources": {
    "iconPath": "BaldursGate3_logo.ico",
    "categoriesPath": "Categories.xml"
  },
  "theme": {
    "primaryColor": "#D1AB5E"
  },
  "setup": {
    "useGenericSetup": true
  },
  "settings": {
    "useGenericSettings": true
  },
  "loadOrder": {
    "schemaVersion": 1,
    "enabled": true,
    "provider": "larian-module-settings-v1",
    "revision": 1,
    "packageRoot": "ManagedInstallation",
    "profileSource": "structuredEffects",
    "directoryPolicy": {
      "allowedExtensions": [ ".pak" ],
      "allowSubdirectories": false
    }
  },
  "structuredEffects": {
    "schemaVersion": 1,
    "provider": "profiled-attribute-records-v1",
    "revision": 1,
    "metadataFile": "info.json",
    "metadataArray": "Mods",
    "metadataEncoding": "Ascii",
    "profileRoot": "Larian Studios\\Baldur's Gate 3\\PlayerProfiles",
    "manifestFile": "modsettings.lsx",
    "excludedProfiles": [
      "default"
    ],
    "keyPrefix": "bg3-modsettings-v1|",
    "containerId": "Mods",
    "recordId": "ModuleShortDesc",
    "identityField": "UUID",
    "fields": [
      {
        "id": "Folder",
        "type": "LSString",
        "sources": [
          "Folder",
          "folderName"
        ]
      },
      {
        "id": "MD5",
        "type": "LSString",
        "value": ""
      },
      {
        "id": "Name",
        "type": "LSString",
        "sources": [
          "Name",
          "modName"
        ]
      },
      {
        "id": "UUID",
        "type": "FixedString",
        "sources": [
          "UUID"
        ]
      },
      {
        "id": "Version64",
        "type": "int64",
        "sources": [
          "Version"
        ],
        "defaultValue": "1"
      }
    ]
  },
  "modInstall": {
    "pathAdjustmentProfile": "none",
      "flattenFileExtensions": [ ".pak" ],
      "primaryFileExtensions": [ ".pak" ],
      "excludedArchiveDirectories": [ "__MACOSX" ],
      "excludedFileNamePrefixes": [ "._" ],
      "fileDestinations": [
        { "sourcePath": "DWrite.dll", "destinationPath": "bin\\DWrite.dll" }
      ],
    "realFileRequiredExtensions": [
      ".exe",
      ".jar",
      ".dll",
      ".gr2"
    ],
    "supportsGameRootInstall": false
  },
  "compatibilityNotes": [
    "Managed mods remain under LocalAppData\\Larian Studios\\Baldur's Gate 3\\Mods, matching the legacy game mode.",
    "Archive paths under bin or Data deploy through the discovered game root as the legacy secondary install path.",
    "info.json remains a special metadata file used to update PlayerProfiles modsettings.lsx; deterministic Collection handling is implemented separately."
  ]
}
