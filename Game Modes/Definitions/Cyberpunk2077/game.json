{
  "schemaVersion": 2,
  "modeId": "Cyberpunk2077",
  "name": "Cyberpunk 2077",
  "runtime": {
    "schemaVersion": 1,
    "startupNotice": {
      "preference": "ShowCP2077UpgradeDisclaimer",
      "minimumVersion": "1.2",
      "includeMinimumVersion": true,
      "text": "We've detected that you are using Cyberpunk 2077 version 1.2 (or later) for the first time with NMM. In version 1.2, \nCDPR changed the folder where mod files are installed.\n\nOlder NMM versions tried to disable every active Cyberpunk 2077 mod at this point. NMM will no longer do that automatically.\n\nYour existing files will be left in place. Please verify your Cyberpunk 2077 mod folder settings and reinstall or reactivate affected mods manually if your setup needs to be moved to the new folder.\n"
    }
  },
  "behaviorProfile": "generic",
  "legacyFallback": false,
  "gameExecutables": [
    "bin\\x64\\Cyberpunk2077.exe"
  ],
  "stopFolders": [
    "archive",
    "bin",
    "engine",
    "mods",
    "r6",
    "red4ext"
  ],
  "discovery": {
    "stores": [
      {
        "store": "Steam",
        "id": "1091500",
        "installFolderName": "Cyberpunk 2077",
        "executableName": "bin\\x64\\Cyberpunk2077.exe"
      },
      {
        "store": "GOG",
        "id": "1423049311",
        "executableName": "bin\\x64\\Cyberpunk2077.exe",
        "registryKey": "HKEY_LOCAL_MACHINE\\SOFTWARE\\WOW6432Node\\GOG.com\\Games\\1423049311",
        "registryValueName": "PATH"
      }
    ]
  },
  "launcher": {
    "defaultExecutable": "bin\\x64\\Cyberpunk2077.exe",
    "prelauncherExecutable": "REDprelauncher.exe",
    "plainCommandName": "PlainLaunch",
    "plainCommandText": "Launch Cyberpunk 2077",
    "customCommandName": "CustomLaunch",
    "customCommandText": "Launch Custom Cyberpunk 2077",
    "defaultCommandText": "Launch Cyberpunk 2077",
    "allowCustomCommand": true
  },
  "resources": {
    "iconPath": "Cyberpunk2077_logo.ico",
    "categoriesPath": "Categories.xml"
  },
  "theme": {
    "primaryColor": "#217893"
  },
  "setup": {
    "useGenericSetup": true
  },
  "settings": {
    "useGenericSettings": true
  },
  "modInstall": {
    "pathAdjustmentProfile": "cyberpunk2077",
    "hardlinkRequiredExtensions": [
      ".mp3",
      ".wav",
      ".ogg"
    ],
    "realFileRequiredExtensions": [
      ".exe",
      ".jar",
      ".dll",
      ".asi",
      ".lua",
      ".toml"
    ],
    "supportsGameRootInstall": true
  }
}
