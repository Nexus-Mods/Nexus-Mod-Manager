{
  "schemaVersion": 2,
  "modeId": "Witcher3Remastered",
  "nexusDomain": "witcher3",
  "name": "The Witcher 3 Remastered",
  "behaviorProfile": "witcher3remastered",
  "legacyFallback": false,
  "gameExecutables": [
    "bin\\x64_dx12\\witcher3.exe"
  ],
  "stopFolders": [
    "Mods",
    "DLC",
    "bin",
    "content",
    "dlc-tombstones"
  ],
  "supportedFormats": [
    "fomod"
  ],
  "discovery": {
    "stores": [
      {
        "store": "Steam",
        "id": "292030",
        "installFolderName": "The Witcher 3",
        "executableName": "bin\\x64_dx12\\witcher3.exe"
      },
      {
        "store": "GOG",
        "id": "1495134320",
        "executableName": "bin\\x64_dx12\\witcher3.exe"
      },
      {
        "store": "GOG",
        "id": "1207664643",
        "executableName": "bin\\x64_dx12\\witcher3.exe"
      },
      {
        "store": "Epic",
        "id": "725a22e15ed74735bb0d6a19f3cc82d0",
        "executableName": "bin\\x64_dx12\\witcher3.exe"
      }
    ]
  },
  "launcher": {
    "defaultExecutable": "bin\\x64_dx12\\witcher3.exe",
    "plainCommandName": "PlainLaunch",
    "plainCommandText": "Launch The Witcher 3 Remastered",
    "defaultCommandText": "Launch The Witcher 3 Remastered",
    "allowCustomCommand": false
  },
  "resources": {
    "iconPath": "witcher3_logo.ico",
    "categoriesPath": "Categories.xml"
  },
  "theme": {
    "primaryColor": "#5D6A70"
  },
  "modInstall": {
    "pathAdjustmentProfile": "none",
    "supportsGameRootInstall": false,
    "realFileRequiredExtensions": [
      ".exe",
      ".dll"
    ]
  },
  "managedContent": {
    "schemaVersion": 1,
    "installLayout": {
      "provider": "bounded-folder-layout-v1",
      "revision": 1,
      "maximumWrapperSegments": 2,
      "ignoredFileNames": [
        "readme.txt",
        "readme.md",
        "license.txt",
        "license.md",
        "changelog.txt",
        "changelog.md",
        ".DS_Store"
      ],
      "rejectedFileSuffixes": [
        ".part.txt"
      ],
      "rules": [
        {
          "id": "mods",
          "kind": "component-folder",
          "componentPrefix": "mod",
          "contentFolder": "content",
          "targetRoot": "Data",
          "targetFolder": "Mods",
          "componentKind": "mod-folder",
          "maximumComponentNameLength": 63,
          "sourceRoot": "Mods"
        },
        {
          "id": "dlc",
          "kind": "component-folder",
          "componentPrefix": "dlc",
          "contentFolder": "content",
          "targetRoot": "Data",
          "targetFolder": "DLC",
          "componentKind": "dlc-folder",
          "maximumComponentNameLength": 255,
          "sourceRoot": "DLC"
        },
        {
          "id": "bare-mod",
          "kind": "component-folder",
          "componentPrefix": "mod",
          "contentFolder": "content",
          "targetRoot": "Data",
          "targetFolder": "Mods",
          "componentKind": "mod-folder",
          "maximumComponentNameLength": 63
        },
        {
          "id": "bare-dlc",
          "kind": "component-folder",
          "componentPrefix": "dlc",
          "contentFolder": "content",
          "targetRoot": "Data",
          "targetFolder": "DLC",
          "componentKind": "dlc-folder",
          "maximumComponentNameLength": 255
        },
        {
          "id": "raw-content",
          "kind": "generated-folder",
          "componentPrefix": "mod",
          "contentFolder": "content",
          "targetRoot": "Data",
          "targetFolder": "Mods",
          "componentKind": "mod-folder",
          "maximumComponentNameLength": 63,
          "sourceRoot": "content"
        }
      ]
    },
    "componentOrdering": {
      "provider": "sectioned-ini-order-v1",
      "revision": 1,
      "fileRoot": "Documents",
      "relativePath": "The Witcher 3\\mods.settings",
      "componentKind": "mod-folder",
      "componentPrefix": "mod",
      "priorityKey": "Priority",
      "enabledKey": "Enabled",
      "editing": "reviewed-sequential-ini-v1"
    }
  },
  "compatibilityNotes": [
    "Dedicated Remastered native basic-package management is enabled with physical-root, edition and ownership validation; Windows gameplay/runtime validation is still required.",
    "Requires 5.x executable-version evidence and no stale DX11 executable; DX12 alone never establishes Remastered.",
    "Uses the witcher3 Nexus catalog while keeping an independent NMM ModeId and native ownership namespace.",
    "Never shares native game storage or InstallLog with Witcher3. In-place upgrades require reviewed migration or an independent physical installation.",
    "Witcher mod folders are not Bethesda plugins. Explicitly approved order and enablement changes publish to Documents/The Witcher 3/mods.settings.",
    "Collections support basic Witcher packages, folder load order, menu records and curator-bundled Script Merger output through reviewed native recipes. Scripted packages, automatic script merging and migration of a Legacy-managed root remain outside this adapter."
  ]
}
